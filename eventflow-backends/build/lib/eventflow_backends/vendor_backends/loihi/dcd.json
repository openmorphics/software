{
  "name": "loihi",
  "vendor": "Intel",
  "family": "Neuromorphic Hardware",
  "version": "0.1.0",
  "time_resolution_ns": 1000,
  "max_jitter_ns": 0,
  "deterministic_modes": ["exact_event"],
  "supported_ops": ["lif", "synapse_exp", "synapse_stdp"],
  "opset_versions": { "lif": "1.0.0", "synapse_exp": "1.0.0", "synapse_stdp": "1.0.0" },
  "neuron_models": ["LIF"],
  "plasticity_rules": ["STDP"],
  "weight_precisions_bits": [8, 16],
  "state_precisions_bits": [8, 16],
  "clock": { "drift_ppm": 0, "sync_method": "other", "deterministic_fixed_step_only": false },
  "limits": { "max_neurons": 131072, "max_synapses": 131072000, "max_fanout": 4096, "max_fanin": 4096, "min_delay_us": 0, "max_delay_us": 1000000 },
  "memory": { "per_core_kib": 256, "per_chip_mib": 32768, "global_mib": 1 },
  "topology": { "multi_chip": true, "cores_per_chip": 128, "max_hops": 1, "router_bandwidth_meps": 1000, "link_latency_us": 10 },
  "power": { "mw_per_spike_typ": 0.01, "idle_mw": 500.0, "tdp_mw": 1000.0 },
  "features": { "on_chip_learning": true, "stochastic_neurons": true, "analog_dynamics": false, "kernel_sandbox": false },
  "overflow_behavior": "drop_tail",
  "conformance_profiles": ["REALTIME"],
  "notes": "Intel Loihi neuromorphic chip. Requires NxSDK for hardware access. Deterministic execution with hardware timing."
}
