{
  "name": "spinnaker",
  "vendor": "University of Manchester",
  "family": "Neuromorphic Hardware",
  "version": "0.1.0",
  "time_resolution_ns": 1000,
  "max_jitter_ns": 1000,
  "deterministic_modes": ["exact_event"],
  "supported_ops": ["lif", "izhikevich", "synapse_exp", "synapse_alpha"],
  "opset_versions": { "lif": "1.0.0", "izhikevich": "1.0.0", "synapse_exp": "1.0.0", "synapse_alpha": "1.0.0" },
  "neuron_models": ["LIF", "Izhikevich"],
  "plasticity_rules": ["STDP", "Spike-Timing-Dependent Plasticity"],
  "weight_precisions_bits": [16, 32],
  "state_precisions_bits": [16, 32],
  "clock": { "drift_ppm": 50, "sync_method": "packet_based", "deterministic_fixed_step_only": false },
  "limits": { "max_neurons": 1000000, "max_synapses": 1000000000, "max_fanout": 10000, "max_fanin": 10000, "min_delay_us": 1, "max_delay_us": 10000 },
  "memory": { "per_core_kib": 128, "per_chip_mib": 128, "global_mib": 0 },
  "topology": { "multi_chip": true, "cores_per_chip": 18, "max_hops": 100, "router_bandwidth_meps": 100, "link_latency_us": 1 },
  "power": { "mw_per_spike_typ": 0.05, "idle_mw": 100.0, "tdp_mw": 500.0 },
  "features": { "on_chip_learning": true, "stochastic_neurons": false, "analog_dynamics": false, "kernel_sandbox": false },
  "overflow_behavior": "drop_tail",
  "conformance_profiles": ["REALTIME"],
  "notes": "SpiNNaker distributed neuromorphic computer. Uses ARM cores with packet-based communication. Requires sPyNNaker for hardware access. Deterministic execution with packet-based timing."
}