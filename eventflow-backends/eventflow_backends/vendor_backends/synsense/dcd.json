{
  "name": "synsense",
  "vendor": "SynSense",
  "family": "Neuromorphic Hardware",
  "version": "0.1.0",
  "time_resolution_ns": 100,
  "max_jitter_ns": 50,
  "deterministic_modes": ["exact_event"],
  "supported_ops": ["lif", "synapse_exp", "xylo_conv", "dynap_conv"],
  "opset_versions": { "lif": "1.0.0", "synapse_exp": "1.0.0", "xylo_conv": "1.0.0", "dynap_conv": "1.0.0" },
  "neuron_models": ["LIF", "AdaptiveLIF"],
  "plasticity_rules": ["STDP"],
  "weight_precisions_bits": [8, 16],
  "state_precisions_bits": [8, 16],
  "clock": { "drift_ppm": 10, "sync_method": "other", "deterministic_fixed_step_only": false },
  "limits": { "max_neurons": 1000000, "max_synapses": 10000000, "max_fanout": 1024, "max_fanin": 1024, "min_delay_us": 0, "max_delay_us": 10000 },
  "memory": { "per_core_kib": 64, "per_chip_mib": 64, "global_mib": 0 },
  "topology": { "multi_chip": true, "cores_per_chip": 1, "max_hops": 1, "router_bandwidth_meps": 10000, "link_latency_us": 1 },
  "power": { "mw_per_spike_typ": 0.001, "idle_mw": 1.0, "tdp_mw": 10.0 },
  "features": { "on_chip_learning": true, "stochastic_neurons": true, "analog_dynamics": true, "kernel_sandbox": false },
  "overflow_behavior": "drop_tail",
  "conformance_profiles": ["REALTIME"],
  "notes": "SynSense Xylo/DYNAP neuromorphic processors. Ultra-low power consumption with real-time processing capabilities. Specialized for audio (Xylo) and vision (DYNAP) processing. Requires SynSense SDK for hardware access. Deterministic execution with sub-microsecond latency."
}