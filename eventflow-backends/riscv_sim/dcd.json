{
  "name": "riscv-sim",
  "vendor": "EventFlow",
  "family": "Simulator",
  "version": "0.1.0",
  "time_resolution_ns": 1000,
  "max_jitter_ns": 0,
  "deterministic_modes": ["exact_event", "fixed_step"],
  "supported_ops": [
    "lif",
    "synapse_exp",
    "delay_line",
    "probe_spike",
    "conv2d_events",
    "conv1d_events",
    "window_reduce_events",
    "threshold_events"
  ],
  "opset_versions": {
    "lif": "1.0.0",
    "synapse_exp": "1.0.0"
  },
  "neuron_models": ["LIF"],
  "plasticity_rules": [],
  "weight_precisions_bits": [8, 16, 32],
  "state_precisions_bits": [16, 32],
  "clock": {
    "drift_ppm": 0,
    "sync_method": "host_sync",
    "deterministic_fixed_step_only": false
  },
  "limits": {
    "max_neurons": 10000000,
    "max_synapses": 100000000,
    "max_fanout": 100000,
    "max_fanin": 100000,
    "min_delay_us": 0,
    "max_delay_us": 100000000
  },
  "memory": {
    "per_core_kib": 1048576,
    "per_chip_mib": 16384,
    "global_mib": 16384
  },
  "topology": {
    "multi_chip": false,
    "cores_per_chip": 1,
    "max_hops": 0,
    "router_bandwidth_meps": 1000,
    "link_latency_us": 0
  },
  "power": {
    "mw_per_spike_typ": 0.0,
    "idle_mw": 0.0,
    "tdp_mw": 0.0
  },
  "features": {
    "on_chip_learning": false,
    "stochastic_neurons": false,
    "analog_dynamics": false,
    "kernel_sandbox": true,
    "evx": true,
    "mmio_rings": true,
    "wfi_wake": true,
    "rv_isa": "RV64IMAC+Zicsr+Zifencei",
    "rvv": { "supported": true, "vlen": 128, "version": "1.0" },
    "evx_csr_base": "0x7C0",
    "evx_mmio_bases": {
      "ctrl": "0xF0000000",
      "in_ring": "0xF1000000",
      "out_ring": "0xF2000000"
    }
  },
  "overflow_behavior": "drop_tail",
  "conformance_profiles": ["BASE", "REALTIME"],
  "notes": "RISC-V instruction-set simulator with EVX (Event eXtensions) and cycle/timing model; deterministic trace emission."
}